{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "timeoffice-route": {
        "ClusterId": "timeoffice-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/timeoffice/{**catch-all}"
        }
      },
      "timeoffice-root-route": {
        "ClusterId": "timeoffice-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/timeoffice"
        }
      },
      "mainapi-route": {
        "ClusterId": "mainapi-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "timeoffice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7014"
          }
        }
      },
      "mainapi-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5012"
          }
        }
      }
    }
  }
}